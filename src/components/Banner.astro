---
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---
<div class="banner">
  <h2>{title}</h2>
  <p>{subtitle}</p>
</div>

<style>
  .banner {
    background: linear-gradient(135deg, #cc0000 0%, #4a0000 100%);
    padding: 40px;
    border-radius: 12px;
    text-align: center;
    margin-bottom: 30px;
    box-shadow: 0 4px 20px rgba(204, 0, 0, 0.2);
  }
  .banner h2 {
    font-size: 2.2rem;
    margin-bottom: 10px;
    color: #ffffff;
  }
  .banner p {
    font-size: 1.1rem;
    color: #f3f4f6;
  }
</style>
